# Database Connection URL (PostgreSQL / NeonDB)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# JWT Secret Key for authenticating sessions
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# Allowed CORS origins (comma-separated or * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://unnati-eta.vercel.app,https://unnati-636c6.web.app
